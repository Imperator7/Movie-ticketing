  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:verify": "docker compose exec -T postgres psql -q -v ON_ERROR_STOP=1 -U postgres -d movie_ticketing < prisma/verify-constraints.sql",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "seed": "tsx prisma/seed/seed.ts",
    "seed:fetch-movies": "tsx prisma/seed/fetch-movies.ts"
  },
