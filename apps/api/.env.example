# Copy to `apps/api/.env` (git-ignored). DEV-ONLY defaults. Passwords must match the root .env.

# The application connects as app_user (DML only, DB-2).
DATABASE_URL="postgresql://app_user:dev_app_user_change_me@localhost:5433/movie_ticketing?schema=public"

# Prisma Migrate connects as migrator (owns the schema, runs DDL).
MIGRATION_DATABASE_URL="postgresql://migrator:dev_migrator_change_me@localhost:5433/movie_ticketing?schema=public"

# Integration tests use a separate database.
TEST_DATABASE_URL="postgresql://app_user:dev_app_user_change_me@localhost:5433/movie_ticketing_test?schema=public"
TEST_MIGRATION_DATABASE_URL="postgresql://migrator:dev_migrator_change_me@localhost:5433/movie_ticketing_test?schema=public"
