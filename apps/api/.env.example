# Copy to `apps/api/.env` (git-ignored). DEV-ONLY defaults. Passwords must match the root .env.

# development | test | production. Placeholder secrets are only accepted in development/test.
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------------------------
# The application connects as app_user (DML only, DB-2).
DATABASE_URL="postgresql://app_user:dev_app_user_change_me@localhost:5433/movie_ticketing?schema=public"
# Connection pool size per API container. Size it against RDS max_connections / number of containers (DB-6).
DB_POOL_MAX=10

# Prisma Migrate connects as migrator (owns the schema, runs DDL). Prisma CLI only, never the running app.
MIGRATION_DATABASE_URL="postgresql://migrator:dev_migrator_change_me@localhost:5433/movie_ticketing?schema=public"

# Integration tests use a separate database.
TEST_DATABASE_URL="postgresql://app_user:dev_app_user_change_me@localhost:5433/movie_ticketing_test?schema=public"
TEST_MIGRATION_DATABASE_URL="postgresql://migrator:dev_migrator_change_me@localhost:5433/movie_ticketing_test?schema=public"

# --- Secrets (API-13) -------------------------------------------------------------------------
# Each must be at least 32 bytes. The values below are dev placeholders and are REJECTED when
# NODE_ENV=production. Generate real ones with: openssl rand -base64 48
JWT_SECRET=dev_jwt_secret_change_me_0123456789abcdef
REFRESH_TOKEN_PEPPER=dev_refresh_pepper_change_me_0123456789abcdef
TICKET_QR_SECRET=dev_ticket_qr_secret_change_me_0123456789abcdef

# --- HTTP -------------------------------------------------------------------------------------
# Browser origin allowed by CORS (only enabled when NODE_ENV=development).
WEB_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (the ALB = 1). 0 = trust none.
TRUST_PROXY_HOPS=0
# Swagger UI at /api/docs. Must stay false in production.
SWAGGER_ENABLED=true

# --- Shutdown / health ------------------------------------------------------------------------
# After SIGTERM, readiness returns 503 for this long before the server closes.
SHUTDOWN_DRAIN_MS=5000
HEALTH_DB_TIMEOUT_MS=2000
