{
  "name": "movie-ticketing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "lint": "turbo run lint",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint:openapi && turbo run lint typecheck test build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w api",
    "db:reset": "npm run db:reset -w api",
    "db:studio": "npm run db:studio -w api",
    "db:verify": "npm run db:verify -w api",
    "db:seed": "npm run seed -w api",
    "movies:fetch": "npm run seed:fetch-movies -w api && npm run mocks:sync-movies -w web && npm run db:seed",
    "test:report": "node scripts/test-report.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@redocly/cli": "^2.71.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "packageManager": "npm@11.6.2",
  "type": "module"
}
