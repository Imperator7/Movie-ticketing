# Copy to `.env` (git-ignored). These are DEV-ONLY defaults, never use them anywhere real.
# Read by docker-compose.yml. The API has its own apps/api/.env.example.

# Postgres superuser: only used by the container to run docker/postgres/init once.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_change_me

# Role that owns the schema and runs migrations (DDL).
MIGRATOR_PASSWORD=dev_migrator_change_me
# Role the application connects as (DML only).
APP_USER_PASSWORD=dev_app_user_change_me

# Database names (the second one is for integration tests).
APP_DB=movie_ticketing
APP_TEST_DB=movie_ticketing_test

# Host port for Postgres (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_HOST_PORT=5433

# ---- Full stack (`npm run stack:up`, http://localhost:8080) ------------------------------------------------------
# `npm run stack:secrets` appends random JWT_SECRET / REFRESH_TOKEN_PEPPER / TICKET_QR_SECRET here (once).
WEB_HOST_PORT=8080
# fake = demo payments (no Stripe account needed). stripe = real Stripe test mode: also set the three keys below and
# start the webhook forwarder with `docker compose --profile stack --profile stripe up -d`.
PAYMENTS_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
