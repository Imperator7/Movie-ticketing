{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mock", "-w", "web"],
      "port": 3000
    },
    {
      "name": "web-windows",
      "runtimeExecutable": "C:\\Program Files\\Git\\bin\\bash.exe",
      "runtimeArgs": [
        "-c",
        "cd apps/web && NEXT_PUBLIC_API_MOCKING=enabled INCLUDE_DEV_PAGES=1 npx next dev -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "api"],
      "port": 4000
    },
    {
      "name": "web-real-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api", "-w", "web"],
      "port": 3000
    },
    {
      "name": "db-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "api",
        "--",
        "prisma",
        "studio",
        "--port",
        "5555",
        "--browser",
        "none"
      ],
      "port": 5555
    }
  ]
}
